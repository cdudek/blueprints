{
  "permissions": {
    "deny": [
      "Bash(gcloud secrets versions access *)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(make dev-real*)",
      "Bash(make secret-set*)",
      "Bash(make secret-rotate*)",
      "Bash(* APPLY=1*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(!./.env.example)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": ["./.env", "./.env.*"]
    }
  }
}
