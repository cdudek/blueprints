{
  "$schema": "tools/common/secrets/manifest.schema.json",
  "schemaVersion": 1,
  "repo": "shop",
  "envs": ["dev", "staging", "prod"],
  "rollbackWindowDays": 7,
  "secrets": {
    "payments-api-key": {
      "description": "Payments provider API key, used by the worker to charge payment requests",
      "owner": "billing",
      "readers": ["worker"],
      "local": true,
      "rotationDays": 90
    }
  }
}
