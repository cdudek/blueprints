#!/usr/bin/env bash
# shellcheck disable=SC2016 # jq programs take their $variables in single quotes
# secrets: declare, set, rotate, rename and check an app's secrets.
# Output is names, version numbers, dates and states, never values. Needs bash 3.2+, jq 1.6+, gcloud.
set +x # a value must never reach a trace, even under `bash -x secrets ...`

SUPPORTED_SCHEMA=1
COMMON_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

# shellcheck source=backends/gcp.bash
. "$COMMON_DIR/secrets/backends/${SECRETS_BACKEND:-gcp}.bash"

die() { printf 'secrets: %s\n' "$*" >&2; exit 1; }
note() { printf 'secrets: %s\n' "$*" >&2; }

# --- naming (plan B) ---------------------------------------------------------------------------

RE_ENV='^(dev|staging|prod|pr-[0-9]{1,4})$'
RE_REPO='^[a-z][a-z0-9-]{1,9}[a-z0-9]$'
KINDS='(web|worker|migrate|ci|deploy|images|files|tfstate|sql|secrets-rotation|[a-z][a-z0-9-]{0,8}[a-z0-9])'
RE_KIND="^${KINDS}\$"
RE_PURPOSE='^[a-z][a-z0-9]*(-[a-z0-9]+)*$'
RE_ENVVAR='^[A-Z][A-Z0-9_]*$'
RE_PROJECT='^[a-z][a-z0-9-]{4,28}[a-z0-9]$'
RE_LABEL='^[a-z0-9_-]{1,63}$'

# has_line LIST ITEM: ITEM is one of LIST's lines (no grep, so no SIGPIPE under pipefail).
has_line() { case $'\n'$1$'\n' in *$'\n'"$2"$'\n'*) return 0 ;; esac; return 1; }

to_envvar() { printf '%s' "$1" | tr 'a-z-' 'A-Z_'; }

# name_ok TYPE VALUE [REPO ENV]: TYPE is env, repo, kind, purpose, resource, sa, secret, envvar or db.
name_ok() {
  local type=$1 value=$2 repo=${3:-} env=${4:-} re
  case $type in
    env) re=$RE_ENV ;;
    repo) re=$RE_REPO ;;
    kind) re=$RE_KIND ;;
    purpose) re=$RE_PURPOSE ;;
    envvar) re=$RE_ENVVAR ;;
    resource | sa)
      [ "$type" = sa ] && [ ${#value} -gt 30 ] && return 1
      re="^${repo}-${KINDS}-${env}\$" ;;
    secret)
      [ ${#value} -le 255 ] || return 1
      re="^${repo}-[a-z][a-z0-9]*(-[a-z0-9]+)*-${env}\$" ;;
    db)
      local r=${repo//-/_} e=${env//-/_}
      re="^${r}_${e}\$" ;;
    *) return 2 ;;
  esac
  case $type in resource | sa | secret | db)
    [[ $repo =~ $RE_REPO ]] && [[ $env =~ $RE_ENV ]] || return 1 ;;
  esac
  [[ $value =~ $re ]]
}

# --- manifest (plan C) -------------------------------------------------------------------------

MANIFEST=${SECRETS_MANIFEST:-secrets.manifest.json}

mjq() { jq -r "$@" "$MANIFEST"; }

# Structure and types; names are checked in bash so one regex set serves the CLI and its tests.
STRUCTURE_JQ='
def int: type == "number" and . == floor;
def str: type == "string" and length > 0;
if type != "object" then "manifest: must be a JSON object" else
  ((keys - ["$schema","schemaVersion","repo","envs","projects","rollbackWindowDays","secrets"])[] | "manifest: unknown key \(.)"),
  (if (.schemaVersion | int) and .schemaVersion >= 1 then empty else "schemaVersion: must be an integer >= 1" end),
  (if .repo | str then empty else "repo: required string" end),
  (if (.envs | type) == "array" and (.envs | length) > 0 and all(.envs[]; str)
   then (if (.envs | unique | length) == (.envs | length) then empty else "envs: duplicate entries" end)
   else "envs: must be a non-empty array of strings" end),
  (if (.rollbackWindowDays | int) and .rollbackWindowDays >= 1 then empty else "rollbackWindowDays: must be an integer >= 1" end),
  (if has("projects") then
     (if (.projects | type) == "object" then (.projects | to_entries[] | select(.value | str | not) | "projects.\(.key): must be a string")
      else "projects: must be an object" end)
   else empty end),
  (if (.secrets | type) != "object" then "secrets: must be an object" else
     .secrets | to_entries[] | .key as $k | .value as $v |
     if ($v | type) != "object" then "secrets.\($k): must be an object" else
       (($v | keys) - ["description","owner","readers","local","rotationDays","probe","generated","ci","ciReason"])[] as $x | "secrets.\($k): unknown key \($x)"
     end,
     if ($v | type) != "object" then empty else
       (if $v.description | str then empty else "secrets.\($k).description: required string" end),
       (if $v.owner | str then empty else "secrets.\($k).owner: required string" end),
       (if ($v.readers | type) == "array" and all($v.readers[]; str) then empty else "secrets.\($k).readers: must be an array of kinds" end),
       (if ($v | has("local")) and ($v.local | type) != "boolean" then "secrets.\($k).local: must be true or false" else empty end),
       (if ($v | has("rotationDays")) and (($v.rotationDays | int) and $v.rotationDays >= 1 | not) then "secrets.\($k).rotationDays: must be an integer >= 1" else empty end),
       (if ($v | has("probe")) and ($v.probe | str | not) then "secrets.\($k).probe: must be a path" else empty end),
       (if ($v | has("generated")) then
          (if ($v.generated | type) == "object" and ($v.generated | keys) == ["bytes"] and ($v.generated.bytes | int) and $v.generated.bytes >= 16 and $v.generated.bytes <= 512
           then empty else "secrets.\($k).generated: must be {\"bytes\": 16..512}" end),
          (if $v | has("probe") then "secrets.\($k): a generated secret has no probe" else empty end)
        else empty end),
       (if ($v | has("ci")) and ($v.ci | type) != "boolean" then "secrets.\($k).ci: must be true or false" else empty end),
       (if $v.ci == true and ($v.ciReason | str | not) then "secrets.\($k): ci needs a ciReason" else empty end),
       (if ($v | has("ciReason")) and $v.ci != true then "secrets.\($k): ciReason without ci: true" else empty end)
     end
   end)
end'

# validate_manifest: prints every problem, returns 1 if there is one. Sets REPO, ENVS, WINDOW.
validate_manifest() {
  [ -f "$MANIFEST" ] || { note "no manifest at $MANIFEST (set SECRETS_MANIFEST)"; return 1; }
  local errs
  errs=$(jq -r "$STRUCTURE_JQ" "$MANIFEST" 2>&1) || { note "manifest: not valid JSON: $errs"; return 1; }
  if [ -n "$errs" ]; then printf '%s\n' "$errs" | sed 's/^/secrets: /' >&2; return 1; fi

  local bad=0 e p k v env
  REPO=$(mjq .repo)
  ENVS=$(mjq '.envs[]')
  WINDOW=$(mjq .rollbackWindowDays)
  name_ok repo "$REPO" || { note "repo: '$REPO' must match $RE_REPO (3 to 11 characters)"; bad=1; }
  for env in $ENVS; do name_ok env "$env" || { note "envs: '$env' must match $RE_ENV"; bad=1; }; done
  while IFS=$'\t' read -r e p; do
    [ -n "$e" ] || continue
    has_line "$ENVS" "$e" || { note "projects.$e: not one of envs"; bad=1; }
    [[ $p =~ $RE_PROJECT ]] || { note "projects.$e: '$p' is not a GCP project id"; bad=1; }
  done < <(mjq '.projects // {} | to_entries[] | "\(.key)\t\(.value)"')
  [ "$bad" = 0 ] || return 1

  while IFS= read -r p; do
    [ -n "$p" ] || continue
    if ! name_ok purpose "$p"; then note "secrets.$p: purpose must be lowercase kebab-case ($RE_PURPOSE)"; bad=1; continue; fi
    case "-$p-" in *"-$REPO-"*) note "secrets.$p: purpose must not repeat the repo '$REPO'"; bad=1 ;; esac
    for env in dev staging prod $ENVS; do
      case "-$p-" in *"-$env-"*) note "secrets.$p: purpose must not repeat the environment '$env'"; bad=1; break ;; esac
    done
    name_ok envvar "$(to_envvar "$p")" || { note "secrets.$p: env var $(to_envvar "$p") is not UPPER_SNAKE"; bad=1; }
    v=$(mjq --arg k "$p" '.secrets[$k].owner')
    [[ $v =~ $RE_LABEL ]] || { note "secrets.$p.owner: '$v' is not a label value (lowercase, digits, _ and -, up to 63)"; bad=1; }
    for k in $(mjq --arg k "$p" '.secrets[$k].readers[]'); do
      if ! name_ok kind "$k"; then note "secrets.$p.readers: '$k' is not a kind"; bad=1; continue; fi
      for env in $ENVS; do
        name_ok sa "$REPO-$k-$env" "$REPO" "$env" || { note "secrets.$p.readers: service account $REPO-$k-$env breaks the naming rule or 30 characters"; bad=1; }
      done
    done
    for env in $ENVS; do
      name_ok secret "$REPO-$p-$env" "$REPO" "$env" || { note "secrets.$p: secret id $REPO-$p-$env breaks the naming rule"; bad=1; }
    done
  done < <(mjq '.secrets | keys[]')

  v=$(mjq .schemaVersion)
  if [ "$v" -gt "$SUPPORTED_SCHEMA" ]; then
    note "warning: manifest schemaVersion $v is newer than this common ($(cat "$COMMON_DIR/VERSION" 2>/dev/null || echo unknown)) supports ($SUPPORTED_SCHEMA); upgrade tools/common"
  fi
  return "$bad"
}

load_manifest() {
  validate_manifest || die "fix $MANIFEST first"
  ROOT=$(cd "$(dirname "$MANIFEST")" && pwd)
}

declared() { [ "$(mjq --arg k "$1" '.secrets | has($k)')" = true ]; }
is_generated() { [ "$(mjq --arg k "$1" '.secrets[$k] | has("generated")')" = true ]; }
purposes() { mjq '.secrets | keys[]'; }

require_declared() {
  declared "$1" || die "'$1' is not declared in $MANIFEST; declare it first, then apply Terraform"
}

require_env() {
  [ -n "$1" ] || die "--env is required"
  name_ok env "$1" || die "--env '$1' must match $RE_ENV"
  has_line "$ENVS" "$1" || die "--env '$1' is not in the manifest's envs"
}

# envs_to_walk ENV_OPT: the one environment asked for, or all of them.
envs_to_walk() { if [ -n "$1" ]; then require_env "$1"; echo "$1"; else echo "$ENVS"; fi; }

project_for() {
  local p
  p=$(mjq --arg e "$1" '.projects[$e] // empty')
  printf '%s' "${p:-$REPO-$1}"
}

secret_id() { printf '%s-%s-%s' "$REPO" "$1" "$2"; }

# --- pins: secret-versions/<env>.json, written only by this CLI, read by Terraform ----------------

pin_file() { printf '%s/secret-versions/%s.json' "$ROOT" "$1"; }

pin_get() {
  local f
  f=$(pin_file "$2")
  [ -f "$f" ] || return 0
  jq -r --arg k "$1" '.[$k] // empty' "$f"
}

pin_set() {
  local f
  f=$(pin_file "$2")
  mkdir -p "$(dirname "$f")"
  [ -f "$f" ] || echo '{}' >"$f"
  jq -S --arg k "$1" --arg v "$3" '.[$k] = $v' "$f" >"$f.tmp" && mv "$f.tmp" "$f"
}

# --- version helpers ---------------------------------------------------------------------------

# age_days CREATED: whole days since an RFC 3339 time (fractional seconds allowed).
age_days() {
  jq -rn --arg t "$1" '(now - ($t | sub("\\.[0-9]+"; "") | fromdateiso8601)) / 86400 | floor'
}

date_in_days() { jq -rn --argjson d "$1" 'now + $d * 86400 | strftime("%Y-%m-%d")'; }

# field VERSIONS N COLUMN: COLUMN 2 is the state, 3 the create time, of version N.
field() { printf '%s\n' "$1" | awk -F '\t' -v n="$2" -v c="$3" '$1 == n { print $c }'; }

# newest_enabled VERSIONS: the highest enabled version number.
newest_enabled() { printf '%s\n' "$1" | awk -F '\t' '$2 == "ENABLED" { print $1 }' | sort -n | tail -1; }

# refs_for LIVE_REFS SECRET_ID: "RESOURCE VERSION" for each live reference to SECRET_ID.
refs_for() { printf '%s\n' "$1" | awk -F '\t' -v s="$2" '$2 == s { print $1 " " $3 }'; }

# --- read-only commands ------------------------------------------------------------------------

cmd_env_names() {
  load_manifest
  local p
  for p in $(purposes); do to_envvar "$p"; echo; done
}

cmd_list() {
  load_manifest
  local envs env project ids p id versions enabled pin readers
  envs=$(envs_to_walk "$ENV_OPT")
  for env in $envs; do
    project=$(project_for "$env")
    ids=$(backend_secret_ids "$project")
    for p in $(purposes); do
      id=$(secret_id "$p" "$env")
      if ! has_line "$ids" "$id"; then
        printf '%s\t%s\tmissing\n' "$env" "$id"
        continue
      fi
      versions=$(backend_versions "$project" "$id")
      enabled=$(printf '%s\n' "$versions" | awk -F '\t' '$2 == "ENABLED" { sub(/T.*/, "", $3); print $1 "@" $3 }' | sort -n | paste -sd, -)
      pin=$(pin_get "$p" "$env")
      if is_generated "$p"; then pin="generated${pin:+ (generation $pin)}"; fi
      readers=$(backend_accessors "$project" "$id")
      printf '%s\t%s\tpinned=%s\tenabled=%s\treaders=%s\n' "$env" "$id" "${pin:-none}" "${enabled:-none}" "${readers:-none}"
    done
  done
}

DRIFT=0
WARNINGS=0
drift() { printf 'DRIFT %s\n' "$*"; DRIFT=$((DRIFT + 1)); }
warn() { printf 'WARN  %s\n' "$*"; WARNINGS=$((WARNINGS + 1)); }

# check_agent_rules: the app's .claude/settings.json keeps every accident guard common ships.
check_agent_rules() {
  local want="$COMMON_DIR/agents/claude-settings.json" have="$ROOT/.claude/settings.json" line
  [ -f "$want" ] || return 0
  if [ ! -f "$have" ]; then drift "agents: .claude/settings.json is missing; merge tools/common/agents/claude-settings.json"; return 0; fi
  jq -e . "$have" >/dev/null 2>&1 || { drift "agents: .claude/settings.json is not valid JSON"; return 0; }
  while IFS= read -r line; do
    [ -n "$line" ] && drift "agents: .claude/settings.json $line"
  done < <(jq -rn --slurpfile w "$want" --slurpfile h "$have" '
    ($w[0].permissions.deny - ($h[0].permissions.deny // []))[] as $r | "does not deny \($r)",
    (if $h[0].sandbox.enabled == true then empty else "does not turn the sandbox on" end),
    ($w[0].sandbox.filesystem.denyRead - ($h[0].sandbox.filesystem.denyRead // []))[] as $r | "sandbox does not deny reading \($r)"')
}

cmd_check() {
  load_manifest
  local envs env project ids refs names declared_ids p id versions newest pin st v age days r rv older type name
  envs=$(envs_to_walk "$ENV_OPT")
  check_agent_rules
  for p in $(purposes); do
    if [ "$(mjq --arg k "$p" '.secrets[$k].ci == true')" = true ]; then
      warn "$p: CI exception, the value also lives in a CI variable ($(mjq --arg k "$p" '.secrets[$k].ciReason'))"
    fi
  done
  for env in $envs; do
    project=$(project_for "$env")
    ids=$(backend_secret_ids "$project")
    refs=$(backend_live_refs "$project")
    names=$(backend_resource_names "$project")
    declared_ids=''
    for p in $(purposes); do
      id=$(secret_id "$p" "$env")
      declared_ids="$declared_ids$id"$'\n'
      if ! has_line "$ids" "$id"; then drift "$env $id: declared but missing in Secret Manager"; continue; fi
      versions=$(backend_versions "$project" "$id")
      newest=$(newest_enabled "$versions")
      if [ -z "$newest" ]; then drift "$env $id: no enabled version"; continue; fi

      if is_generated "$p"; then
        pin=$newest # Terraform writes generated values; the live one is the newest enabled version
      else
        pin=$(pin_get "$p" "$env")
        if [ -z "$pin" ]; then
          drift "$env $id: no pinned version in secret-versions/$env.json"
        else
          st=$(field "$versions" "$pin" 2)
          if [ -z "$st" ]; then drift "$env $id: pinned version $pin does not exist"
          elif [ "$st" != ENABLED ]; then drift "$env $id: pinned version $pin is $st"
          elif [ "$newest" -gt "$pin" ]; then warn "$env $id: version $newest is newer than the pin $pin and not rolled out"
          fi
        fi
      fi

      days=$(mjq --arg k "$p" '.secrets[$k].rotationDays // empty')
      if [ -n "$days" ]; then
        age=$(age_days "$(field "$versions" "$newest" 3)")
        [ "$age" -lt "$days" ] || warn "$env $id: rotation overdue, newest version is $age days old (rotationDays $days)"
      fi

      if [ -n "$pin" ] && [ -n "$(field "$versions" "$pin" 3)" ] && [ "$(age_days "$(field "$versions" "$pin" 3)")" -ge "$WINDOW" ]; then
        older=$(printf '%s\n' "$versions" | awk -F '\t' -v p="$pin" '$2 == "ENABLED" && $1 + 0 < p + 0 { print $1 }' | sort -n | paste -sd, -)
        [ -z "$older" ] || warn "$env $id: versions $older are older than the live version $pin and past the ${WINDOW}-day rollback window; run retire"
      fi

      while read -r r rv; do
        [ -n "$r" ] || continue
        if [ "$rv" = latest ]; then drift "$env $id: $r reads latest; pin a version"
        elif [ -n "$pin" ] && [ "$rv" != "$pin" ]; then drift "$env $id: $r reads version $rv, the pin is $pin (Terraform not applied?)"
        fi
      done < <(refs_for "$refs" "$id")
    done

    for id in $ids; do
      has_line "$declared_ids" "$id" || drift "$env $id: in Secret Manager but not declared in the manifest"
    done

    while IFS=$'\t' read -r type name; do
      [ -n "$name" ] || continue
      v=resource
      [ "$type" = sa ] && v=sa
      name_ok "$v" "$name" "$REPO" "$env" || drift "$env $type $name: breaks <repo>-<kind>-<env> ($REPO-<kind>-$env)"
    done < <(printf '%s\n' "$names")
  done
  printf 'check: %d drift, %d warnings\n' "$DRIFT" "$WARNINGS"
  [ "$DRIFT" -eq 0 ]
}

# --- writing commands (a human runs these) -----------------------------------------------------

# read_value ID: puts the value in VALUE, from stdin (--stdin) or a hidden prompt on the terminal.
# SECRETS_TTY replaces /dev/tty in tests only.
read_value() {
  VALUE=''
  if [ "$STDIN" = 1 ]; then
    IFS= read -r -d '' VALUE || true
  else
    local tty=${SECRETS_TTY:-/dev/tty}
    { : <"$tty"; } 2>/dev/null || die "no terminal: run this in your own terminal (or pipe the value with --stdin)"
    printf 'Value for %s (input hidden): ' "$1" >&2
    IFS= read -r -s VALUE <"$tty" || true
    printf '\n' >&2
  fi
  [ -n "$VALUE" ] || die "empty value; nothing stored"
}

# run_probe NAME: the manifest's probe reads VALUE on stdin and exits 0 if the vendor accepts it.
run_probe() {
  local probe
  probe=$(mjq --arg k "$1" '.secrets[$k].probe // empty')
  [ -n "$probe" ] || return 0
  [ -x "$ROOT/$probe" ] || die "probe $probe is not an executable file"
  # The probe's output is discarded: a faulty probe could echo the value.
  { printf '%s' "$VALUE" || true; } | "$ROOT/$probe" >/dev/null 2>&1 ||
    die "probe $probe rejected the value; nothing stored"
  note "probe $probe accepted the value"
}

# do_set NAME ENV: read, probe, add a version and pin it. Sets NEW_VERSION.
do_set() {
  local project id
  project=$(project_for "$2")
  id=$(secret_id "$1" "$2")
  read_value "$id"
  run_probe "$1"
  NEW_VERSION=$(printf '%s' "$VALUE" | backend_add_version "$project" "$id")
  VALUE=''
  [[ $NEW_VERSION =~ ^[0-9]+$ ]] || die "$id: the backend returned no version number"
  pin_set "$1" "$2" "$NEW_VERSION"
  echo "$id: added version $NEW_VERSION and pinned it in secret-versions/$2.json"
}

# disable_except PROJECT ID KEEP: disables every enabled version but KEEP.
disable_except() {
  local v
  for v in $(backend_enabled_versions "$1" "$2"); do
    [ "$v" = "$3" ] && continue
    backend_disable_version "$1" "$2" "$v"
    echo "$2: disabled version $v"
  done
}

# writable_secret USAGE: checks NAME and ENV for set, rotate and retire.
writable_secret() {
  [ -n "$ARG1" ] && [ -z "$ARG2" ] || die "usage: secrets $1"
  load_manifest
  require_env "$ENV_OPT"
  require_declared "$ARG1"
}

cmd_set() {
  writable_secret "set NAME --env E [--stdin] [--disable-previous]"
  local p=$ARG1 env=$ENV_OPT
  if is_generated "$p"; then die "'$p' is generated by Terraform; use rotate to regenerate it"; fi
  do_set "$p" "$env"
  if [ "$DISABLE_PREVIOUS" = 1 ]; then
    disable_except "$(project_for "$env")" "$(secret_id "$p" "$env")" "$NEW_VERSION"
    note "previous versions are disabled now: revisions still reading them fail at their next instance start"
  fi
  echo "next: commit secret-versions/$env.json; CI applies Terraform; then make secret-check ENV=$env"
}

# rotate: the first run adds and pins a version. A later run, once every live revision reads the
# pin, disables the older versions. Disabling is reversible; the rollback window applies to destroy.
cmd_rotate() {
  writable_secret "rotate NAME --env E"
  local p=$ARG1 env=$ENV_OPT project id pin others waiting='' r rv
  project=$(project_for "$env")
  id=$(secret_id "$p" "$env")
  if is_generated "$p"; then
    pin=$(pin_get "$p" "$env")
    pin=$((${pin:-1} + 1))
    pin_set "$p" "$env" "$pin"
    echo "$id: generation $pin requested in secret-versions/$env.json; Terraform writes the new value"
    echo "next: commit secret-versions/$env.json; CI applies Terraform; after ${WINDOW} days: secrets retire $p --env $env"
    return 0
  fi
  pin=$(pin_get "$p" "$env")
  others=$(backend_enabled_versions "$project" "$id" | awk -v p="$pin" 'NF && $1 != p')
  if [ -n "$pin" ] && [ -n "$others" ]; then
    while read -r r rv; do
      if [ -n "$r" ] && [ "$rv" != "$pin" ]; then waiting="$waiting $r@$rv"; fi
    done < <(refs_for "$(backend_live_refs "$project")" "$id")
    if [ -n "$waiting" ]; then
      echo "$id: waiting for the rollout of version $pin; still on an older version:$waiting"
      echo "next: commit secret-versions/$env.json, let CI apply Terraform, then run rotate again"
      return 0
    fi
    disable_except "$project" "$id" "$pin"
    echo "$id: rotation complete, version $pin is live; running rotate again starts a new rotation"
    echo "next: after the ${WINDOW}-day rollback window ($(date_in_days "$WINDOW")): secrets retire $p --env $env --destroy"
    return 0
  fi
  do_set "$p" "$env"
  echo "next: commit secret-versions/$env.json; CI applies Terraform; then run rotate again to disable the old versions"
}

# retire: disables the versions older than the live one once the live one has been out for the
# rollback window; --destroy destroys the disabled ones; --all retires a secret nothing reads any more.
cmd_retire() {
  writable_secret "retire NAME --env E [--destroy] [--all]"
  local p=$ARG1 env=$ENV_OPT project id versions refs live age want=ENABLED targets v r rv
  [ "$DESTROY" = 1 ] && want=DISABLED
  project=$(project_for "$env")
  id=$(secret_id "$p" "$env")
  versions=$(backend_versions "$project" "$id")
  refs=$(refs_for "$(backend_live_refs "$project")" "$id")
  if [ "$ALL" = 1 ]; then
    [ -z "$refs" ] || die "$id is still read by: $(printf '%s' "$refs" | tr '\n' ' '); move those readers first"
    targets=$(printf '%s\n' "$versions" | awk -F '\t' -v w="$want" '$2 == w { print $1 }' | sort -n)
  else
    if is_generated "$p"; then live=$(newest_enabled "$versions"); else live=$(pin_get "$p" "$env"); fi
    [ -n "$live" ] || die "$id has no live version; for a secret nothing reads any more, use --all"
    [ "$(field "$versions" "$live" 2)" = ENABLED ] || die "$id: the live version $live is not enabled"
    while read -r r rv; do
      [ -z "$r" ] || [ "$rv" = "$live" ] || die "$id: $r still reads version $rv, not the live version $live; roll out first"
    done < <(printf '%s\n' "$refs")
    age=$(age_days "$(field "$versions" "$live" 3)")
    [ "$age" -ge "$WINDOW" ] ||
      die "$id: the live version $live is $age days old, inside the ${WINDOW}-day rollback window; retire from $(date_in_days $((WINDOW - age)))"
    targets=$(printf '%s\n' "$versions" | awk -F '\t' -v l="$live" -v w="$want" '$2 == w && $1 + 0 < l + 0 { print $1 }' | sort -n)
  fi
  if [ -z "$targets" ]; then echo "$id: nothing to retire"; return 0; fi
  for v in $targets; do
    if [ "$DESTROY" = 1 ]; then
      backend_destroy_version "$project" "$id" "$v"
      echo "$id: version $v destroyed (after the secret's destroy delay)"
    else
      backend_disable_version "$project" "$id" "$v"
      echo "$id: disabled version $v"
    fi
  done
  if [ "$DESTROY" != 1 ]; then
    local all=''
    [ "$ALL" = 1 ] && all=' --all'
    echo "next: once nothing needs them, secrets retire $p --env $env --destroy$all"
  fi
}

# dev-env -- CMD: exports each local secret from dev (export is a builtin: no argv, nothing on disk),
# then execs CMD.
cmd_dev_env() {
  [ "${1:-}" = -- ] && [ $# -ge 2 ] || die "usage: secrets dev-env -- CMD..."
  shift
  load_manifest
  has_line "$ENVS" dev || die "the manifest has no dev environment"
  local project p id v value
  project=$(project_for dev)
  for p in $(mjq '.secrets | to_entries[] | select(.value.local == true) | .key'); do
    id=$(secret_id "$p" dev)
    v=$(pin_get "$p" dev)
    if [ -z "$v" ] || is_generated "$p"; then v=$(backend_enabled_versions "$project" "$id" | tail -1); fi
    [ -n "$v" ] || die "$id has no enabled version"
    # The trailing x keeps trailing newlines that $(...) would strip.
    value=$(backend_access_version "$project" "$id" "$v" && printf x) ||
      die "cannot read $id version $v (people hold dev access on local secrets only)"
    export "$(to_envvar "$p")=${value%x}"
    value=''
  done
  exec "$@"
}

# --- renames -----------------------------------------------------------------------------------

# copy_newest PROJECT FROM_ID TO_ID: copies FROM's newest enabled version, resolved explicitly rather
# than through the latest alias, into TO. The value passes through a shell variable: never printed,
# never on disk, never in argv. Sets COPIED_FROM and COPIED_TO.
copy_newest() {
  local value
  COPIED_FROM=$(backend_enabled_versions "$1" "$2" | tail -1)
  [ -n "$COPIED_FROM" ] || die "$2 has no enabled version to copy"
  if ! value=$(backend_access_version "$1" "$2" "$COPIED_FROM" && printf x); then
    note "cannot read $2 version $COPIED_FROM. Nobody holds standing payload access in staging and prod;"
    note "an admin grants it for one day, for example:"
    backend_access_grant_hint "$1" "$2" "$(jq -rn 'now + 86400 | strftime("%Y-%m-%dT%H:%M:%SZ")')" >&2
    exit 1
  fi
  COPIED_TO=$(printf '%s' "${value%x}" | backend_add_version "$1" "$3")
  value=''
  [[ $COPIED_TO =~ ^[0-9]+$ ]] || die "$3: the backend returned no version number"
}

cmd_rename() {
  load_manifest
  local old=$ARG1 new=$ARG2 env=$ENV_OPT project ids old_id new_id v
  [ -n "$old" ] && [ -n "$new" ] || die "usage: secrets rename OLD NEW --env E [--apply]"
  require_env "$env"
  [ "$old" != "$new" ] || die "OLD and NEW are the same"
  name_ok purpose "$new" || die "NEW '$new' must be lowercase kebab-case ($RE_PURPOSE)"
  project=$(project_for "$env")
  old_id=$(secret_id "$old" "$env")
  new_id=$(secret_id "$new" "$env")
  name_ok secret "$new_id" "$REPO" "$env" || die "$new_id breaks the naming rule"
  ids=$(backend_secret_ids "$project")
  has_line "$ids" "$old_id" || die "$old_id does not exist in $project"
  v=$(backend_enabled_versions "$project" "$old_id" | tail -1)
  [ -n "$v" ] || die "$old_id has no enabled version"

  if [ "$APPLY" != 1 ]; then
    echo "rename (dry run, nothing changes): $old_id -> $new_id in $project"
    echo "  copies version $v, the newest enabled one; $old_id stays readable until it is retired"
    echo "  env var: $(to_envvar "$old") -> $(to_envvar "$new")"
    if declared "$new"; then
      echo "  manifest: \"$new\" is declared"
    else
      echo "  manifest: declare \"$new\" and keep \"$old\" until it is retired:"
      mjq --arg o "$old" --arg n "$new" '{($n): (.secrets[$o] // {description: "", owner: "", readers: []})}' | sed 's/^/  + /'
    fi
    echo "  then apply Terraform, and in your own terminal: secrets rename $old $new --env $env --apply"
    return 0
  fi

  declared "$new" || die "declare \"$new\" in $MANIFEST and apply Terraform first (the dry run shows the entry)"
  if is_generated "$new"; then die "\"$new\" is generated: Terraform writes its value, nothing to copy"; fi
  has_line "$ids" "$new_id" || die "$new_id does not exist yet; apply Terraform first"
  copy_newest "$project" "$old_id" "$new_id"
  pin_set "$new" "$env" "$COPIED_TO"
  echo "$old_id version $COPIED_FROM copied to $new_id version $COPIED_TO, pinned in secret-versions/$env.json"
  echo "next: read $(to_envvar "$new") in the app, update Terraform, commit and roll out the revisions that read $new_id;"
  echo "      after the ${WINDOW}-day rollback window ($(date_in_days "$WINDOW")): secrets retire $old --env $env --all,"
  echo "      then remove \"$old\" from the manifest"
}

cmd_rename_repo() {
  load_manifest
  local old=$ARG1 new=$ARG2 env=$ENV_OPT project ids id p pairs='' count=0 answer tty
  [ -n "$old" ] && [ -n "$new" ] || die "usage: secrets rename-repo OLD_REPO NEW_REPO --env E [--apply]"
  require_env "$env"
  name_ok repo "$old" || die "OLD_REPO '$old' must match $RE_REPO"
  name_ok repo "$new" || die "NEW_REPO '$new' must match $RE_REPO"
  [ "$old" != "$new" ] || die "OLD_REPO and NEW_REPO are the same"
  project=$(mjq --arg e "$env" '.projects[$e] // empty')
  [ -n "$project" ] || die "set projects.$env in the manifest first: a repository rename keeps the GCP project"
  ids=$(backend_secret_ids "$project")
  for id in $ids; do
    case $id in "$old"-*-"$env") ;; *) continue ;; esac
    p=${id#"$old"-}
    p=${p%-"$env"}
    name_ok purpose "$p" || { note "skipping $id: '$p' is not a purpose"; continue; }
    pairs="$pairs$p"$'\n'
    count=$((count + 1))
  done
  if [ "$count" -eq 0 ]; then echo "nothing to rename: no $old-*-$env secret in $project"; return 0; fi

  if [ "$APPLY" != 1 ]; then
    echo "rename-repo (dry run, nothing changes): $count secrets in $project"
    for p in $pairs; do echo "  $old-$p-$env -> $new-$p-$env"; done
    if [ "$REPO" = "$old" ]; then
      echo "  manifest:"
      echo "  -   \"repo\": \"$old\","
      echo "  +   \"repo\": \"$new\","
    elif [ "$REPO" = "$new" ]; then
      echo "  manifest: already names \"$new\""
    else
      echo "  manifest: names \"$REPO\", neither \"$old\" nor \"$new\""
    fi
    for p in $pairs; do
      if ! declared "$p"; then echo "  manifest: \"$p\" is not declared; declare it, or retire $old-$p-$env instead"
      elif is_generated "$p"; then echo "  $p is generated: not copied, Terraform writes a new value for $new-$p-$env"
      fi
    done
    echo "  then apply Terraform with repo \"$new\", and in your own terminal: secrets rename-repo $old $new --env $env --apply"
    return 0
  fi

  [ "$REPO" = "$new" ] || die "change repo to \"$new\" in the manifest and apply Terraform first"
  for p in $pairs; do
    declared "$p" || die "\"$p\" is not declared; declare it, or retire $old-$p-$env first"
    has_line "$ids" "$new-$p-$env" || die "$new-$p-$env does not exist yet; apply Terraform first"
  done
  tty=${SECRETS_TTY:-/dev/tty}
  { : <"$tty"; } 2>/dev/null || die "no terminal: run this in your own terminal"
  printf 'Copy %d secrets from %s-*-%s to %s-*-%s in %s? Type %s to go on: ' "$count" "$old" "$env" "$new" "$env" "$project" "$new" >&2
  IFS= read -r answer <"$tty" || true
  [ "$answer" = "$new" ] || die "not confirmed; nothing copied"
  for p in $pairs; do
    if is_generated "$p"; then echo "$new-$p-$env: generated, Terraform wrote a new value; not copied"; continue; fi
    copy_newest "$project" "$old-$p-$env" "$new-$p-$env"
    pin_set "$p" "$env" "$COPIED_TO"
    echo "$old-$p-$env version $COPIED_FROM copied to $new-$p-$env version $COPIED_TO"
  done
  echo "pinned in secret-versions/$env.json"
  echo "next: commit, deploy under the new names (docs/rename-repo.md); after the ${WINDOW}-day rollback window"
  echo "      ($(date_in_days "$WINDOW")) retire the $old-*-$env secrets"
}

# --- main ----------------------------------------------------------------------------------------

usage() {
  cat <<'EOF'
usage: secrets <command> [args]

  list [--env E]                                  versions, pins and readers per secret
  check [--env E]                                 manifest, naming, pins and live references; non-zero on drift
  env-names                                       the env var names the manifest declares
  set NAME --env E [--stdin] [--disable-previous] add a version from a hidden prompt (human)
  rotate NAME --env E                             set; rerun after the rollout to disable old versions (human)
  retire NAME --env E [--destroy] [--all]         disable, then destroy, versions past the rollback window (human)
  rename OLD NEW --env E [--apply]                copy OLD's newest version to NEW; dry run without --apply
  rename-repo OLD_REPO NEW_REPO --env E [--apply] copy every secret to the new repo name; dry run without --apply
  dev-env -- CMD...                               run CMD with the local dev secrets in its environment (human)

The manifest is ./secrets.manifest.json, or SECRETS_MANIFEST.
EOF
}

ENV_OPT='' STDIN=0 DISABLE_PREVIOUS=0 APPLY=0 DESTROY=0 ALL=0 ARG1='' ARG2=''

parse_args() {
  while [ $# -gt 0 ]; do
    case $1 in
      --env) [ $# -ge 2 ] || die "--env needs a value"; ENV_OPT=$2; shift 2 ;;
      --env=*) ENV_OPT=${1#*=}; shift ;;
      --stdin) STDIN=1; shift ;;
      --disable-previous) DISABLE_PREVIOUS=1; shift ;;
      --apply) APPLY=1; shift ;;
      --destroy) DESTROY=1; shift ;;
      --all) ALL=1; shift ;;
      -*) die "unknown option '$1'" ;;
      *)
        if [ -z "$ARG1" ]; then ARG1=$1; elif [ -z "$ARG2" ]; then ARG2=$1; else die "too many arguments"; fi
        shift ;;
    esac
  done
}

main() {
  local cmd=${1:-}
  [ $# -gt 0 ] && shift
  case $cmd in
    -h | --help | help | "") usage; return ;;
  esac
  if [ "$cmd" = dev-env ]; then cmd_dev_env "$@"; fi
  parse_args "$@"
  case $cmd in
    list) cmd_list ;;
    check) cmd_check ;;
    env-names) cmd_env_names ;;
    set) cmd_set ;;
    rotate) cmd_rotate ;;
    retire) cmd_retire ;;
    rename) cmd_rename ;;
    rename-repo) cmd_rename_repo ;;
    *) usage >&2; die "unknown command '$cmd'" ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  set -euo pipefail
  main "$@"
fi
