#!/usr/bin/env bats
# shellcheck disable=SC2016 # bash -c scripts expand their own $1 and $CLI
# set, rotate, retire and dev-env: values reach gcloud only on stdin and the child only through its
# environment; a planted value never appears in output, recorded argv, the app's files or temp files.

load helpers

setup() {
  setup_app
  seed_healthy
}

has() { printf '%s' "$output" | grep -qF -- "$1" || { echo "expected '$1' in: $output"; return 1; }; }
no_add() { if grep -q 'versions add' "$STUB_STATE/argv.log"; then echo "a version was added"; return 1; fi; }

@test "set --stdin adds a version on stdin, pins it and prints no value" {
  run bash -c 'printf %s "$1" | "${SECRETS_BASH:-bash}" "$CLI" set payments-api-key --env dev --stdin' _ "$PLANTED"
  [ "$status" -eq 0 ]
  has "shop-payments-api-key-dev: added version 2 and pinned it"
  has "next: commit secret-versions/dev.json"
  [ "$(pin_of payments-api-key dev)" = 2 ]
  [ "$(cat "$STUB_STATE/stdin.log")" = "$PLANTED" ]
  assert_no_leak
}

@test "set leaks nothing even under bash -x" {
  run bash -c 'printf %s "$1" | "${SECRETS_BASH:-bash}" -x "$CLI" set payments-api-key --env dev --stdin' _ "$PLANTED"
  [ "$status" -eq 0 ]
  assert_no_leak
}

@test "set reads a hidden prompt from the terminal" {
  printf '%s\n' "$PLANTED" >"$BATS_TEST_TMPDIR/terminal"
  SECRETS_TTY="$BATS_TEST_TMPDIR/terminal" run secrets set payments-api-key --env dev
  [ "$status" -eq 0 ]
  has "Value for shop-payments-api-key-dev (input hidden):"
  [ "$(cat "$STUB_STATE/stdin.log")" = "$PLANTED" ]
  assert_no_leak
}

@test "set without a terminal and without --stdin stops" {
  run secrets set payments-api-key --env dev </dev/null
  [ "$status" -eq 1 ]
  has "run this in your own terminal"
  no_add
}

@test "set refuses an undeclared secret" {
  run bash -c 'printf x | "${SECRETS_BASH:-bash}" "$CLI" set payments-key --env dev --stdin'
  [ "$status" -eq 1 ]
  has "'payments-key' is not declared"
  no_add
}

@test "set refuses a generated secret" {
  run bash -c 'printf x | "${SECRETS_BASH:-bash}" "$CLI" set session-signing-key --env dev --stdin'
  [ "$status" -eq 1 ]
  has "generated by Terraform"
  no_add
}

@test "set stops when the probe rejects the value" {
  run bash -c 'printf rejected | "${SECRETS_BASH:-bash}" "$CLI" set payments-api-key --env dev --stdin'
  [ "$status" -eq 1 ]
  has "rejected the value; nothing stored"
  no_add
}

@test "set refuses an empty value" {
  run bash -c '"${SECRETS_BASH:-bash}" "$CLI" set payments-api-key --env dev --stdin </dev/null'
  [ "$status" -eq 1 ]
  has "empty value"
  no_add
}

@test "set --disable-previous disables the other versions at once" {
  run bash -c 'printf %s "$1" | "${SECRETS_BASH:-bash}" "$CLI" set payments-api-key --env dev --stdin --disable-previous' _ "$PLANTED"
  [ "$status" -eq 0 ]
  [ "$(state_of shop-payments-api-key-dev 1)" = DISABLED ]
  [ "$(state_of shop-payments-api-key-dev 2)" = ENABLED ]
  assert_no_leak
}

@test "rotate: the first run sets, the next waits for the rollout, the last disables the old version" {
  run bash -c 'printf %s "$1" | "${SECRETS_BASH:-bash}" "$CLI" rotate payments-api-key --env dev --stdin' _ "$PLANTED"
  [ "$status" -eq 0 ]
  has "added version 2"
  [ "$(pin_of payments-api-key dev)" = 2 ]
  assert_no_leak

  run secrets rotate payments-api-key --env dev
  [ "$status" -eq 0 ]
  has "waiting for the rollout of version 2; still on an older version: shop-web-dev@1 shop-migrate-dev@1"
  [ "$(state_of shop-payments-api-key-dev 1)" = ENABLED ]

  rm "$STUB_STATE/run/shop-dev/services.json" "$STUB_STATE/run/shop-dev/jobs.json"
  seed_service services shop-web-dev shop-payments-api-key-dev 2
  run secrets rotate payments-api-key --env dev
  [ "$status" -eq 0 ]
  has "disabled version 1"
  has "rotation complete, version 2 is live"
  [ "$(state_of shop-payments-api-key-dev 1)" = DISABLED ]
  assert_no_leak
}

@test "rotate on a generated secret asks Terraform for a new generation" {
  run secrets rotate session-signing-key --env dev
  [ "$status" -eq 0 ]
  [ "$(pin_of session-signing-key dev)" = 2 ]
  no_add
}

@test "retire refuses inside the rollback window" {
  seed_version shop-payments-api-key-dev 2 ENABLED "$(days_ago 2)" "$PLANTED"
  echo '{"payments-api-key": "2"}' >"$APP/secret-versions/dev.json"
  rm "$STUB_STATE/run/shop-dev/services.json" "$STUB_STATE/run/shop-dev/jobs.json"
  run secrets retire payments-api-key --env dev
  [ "$status" -eq 1 ]
  has "inside the 7-day rollback window"
  [ "$(state_of shop-payments-api-key-dev 1)" = ENABLED ]
}

@test "retire disables older versions after the window, then --destroy destroys them" {
  seed_version shop-payments-api-key-dev 1 ENABLED "$(days_ago 40)" old
  seed_version shop-payments-api-key-dev 2 ENABLED "$(days_ago 9)" "$PLANTED"
  echo '{"payments-api-key": "2"}' >"$APP/secret-versions/dev.json"
  rm "$STUB_STATE/run/shop-dev/services.json" "$STUB_STATE/run/shop-dev/jobs.json"
  seed_service services shop-web-dev shop-payments-api-key-dev 2
  run secrets retire payments-api-key --env dev
  [ "$status" -eq 0 ]
  has "disabled version 1"
  [ "$(state_of shop-payments-api-key-dev 1)" = DISABLED ]
  [ "$(state_of shop-payments-api-key-dev 2)" = ENABLED ]
  run secrets retire payments-api-key --env dev --destroy
  [ "$status" -eq 0 ]
  [ "$(state_of shop-payments-api-key-dev 1)" = DESTROYED ]
  assert_no_leak
}

@test "retire refuses while a live revision reads an older version" {
  seed_version shop-payments-api-key-dev 1 ENABLED "$(days_ago 40)" old
  seed_version shop-payments-api-key-dev 2 ENABLED "$(days_ago 9)" "$PLANTED"
  echo '{"payments-api-key": "2"}' >"$APP/secret-versions/dev.json"
  run secrets retire payments-api-key --env dev
  [ "$status" -eq 1 ]
  has "shop-web-dev still reads version 1"
  [ "$(state_of shop-payments-api-key-dev 1)" = ENABLED ]
}

@test "retire --all refuses while anything reads the secret, then retires every version" {
  run secrets retire payments-api-key --env dev --all
  [ "$status" -eq 1 ]
  has "still read by"
  rm "$STUB_STATE/run/shop-dev/services.json" "$STUB_STATE/run/shop-dev/jobs.json"
  run secrets retire payments-api-key --env dev --all
  [ "$status" -eq 0 ]
  [ "$(state_of shop-payments-api-key-dev 1)" = DISABLED ]
  has "--destroy --all"
}

@test "dev-env exports only local secrets to the command, byte for byte" {
  seed_version shop-payments-api-key-dev 1 ENABLED "$(days_ago 1)" "$PLANTED"$'\n'
  export EXPECTED="$PLANTED"$'\n'
  run secrets dev-env -- bash -c '[ "$PAYMENTS_API_KEY" = "$EXPECTED" ] && [ -z "${SESSION_SIGNING_KEY:-}" ] && echo child-ok'
  unset EXPECTED
  [ "$status" -eq 0 ]
  [ "$output" = child-ok ]
  assert_no_leak
}

@test "dev-env stops before running the command when a value cannot be read" {
  STUB_DENY_ACCESS=1 run secrets dev-env -- echo child-ran
  [ "$status" -eq 1 ]
  has "cannot read shop-payments-api-key-dev"
  if printf '%s' "$output" | grep -q child-ran; then echo "the command ran"; return 1; fi
}

@test "dev-env needs a command after --" {
  run secrets dev-env
  [ "$status" -eq 1 ]
  has "usage: secrets dev-env -- CMD"
}
