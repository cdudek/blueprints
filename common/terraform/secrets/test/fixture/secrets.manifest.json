{
  "$schema": "../../../../secrets/manifest.schema.json",
  "schemaVersion": 1,
  "repo": "shop",
  "envs": [
    "dev",
    "staging",
    "prod"
  ],
  "rollbackWindowDays": 7,
  "secrets": {
    "payments-api-key": {
      "description": "Payments provider secret key, used for charges and refunds",
      "owner": "billing",
      "readers": [
        "web",
        "worker",
        "migrate"
      ],
      "local": true,
      "rotationDays": 90
    },
    "session-signing-key": {
      "description": "Signs session cookies",
      "owner": "platform",
      "readers": [
        "web"
      ],
      "generated": {
        "bytes": 32
      }
    }
  }
}
