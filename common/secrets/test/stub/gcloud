#!/usr/bin/env bash
# Test double for gcloud: records every argv line, keeps Secret Manager and Cloud Run state in files
# under $STUB_STATE, and fails on anything it does not know. No network, no credentials.
set -eu
S=${STUB_STATE:?STUB_STATE is not set}
printf '%s\n' "$*" >>"$S/argv.log"

pos='' project='' secret='' filter='' format=''
while [ $# -gt 0 ]; do
  case $1 in
    --project) project=$2; shift 2 ;;
    --project=*) project=${1#*=}; shift ;;
    --secret) secret=$2; shift 2 ;;
    --filter=*) filter=${1#*=}; shift ;;
    --format=*) format=${1#*=}; shift ;;
    --data-file=-) shift ;;
    --quiet) shift ;;
    -*) echo "stub gcloud: unknown flag $1" >&2; exit 2 ;;
    *) pos="$pos${pos:+ }$1"; shift ;;
  esac
done
[ -n "$project" ] || { echo "stub gcloud: --project is required" >&2; exit 2; }
sm="$S/sm/$project"

need_secret() { [ -d "$sm/$1" ] || { echo "ERROR: NOT_FOUND: secret [$1]" >&2; exit 1; }; }
need_version() { [ -f "$sm/$1/$2.state" ] || { echo "ERROR: NOT_FOUND: version [$2] of [$1]" >&2; exit 1; }; }

case $pos in
  "secrets list")
    if [ -d "$sm" ]; then ls "$sm"; fi
    ;;
  "secrets versions list "*)
    id=${pos#secrets versions list }
    need_secret "$id"
    for f in "$sm/$id"/*.state; do
      [ -f "$f" ] || continue
      n=$(basename "$f" .state) st=$(cat "$f")
      [ "$filter" = state=ENABLED ] && [ "$st" != ENABLED ] && continue
      if [ "$format" = 'value(name.basename())' ]; then echo "$n"; else printf '%s\t%s\t%s\n' "$n" "$st" "$(cat "$sm/$id/$n.time")"; fi
    done | sort -rn
    ;;
  "secrets versions add "*)
    id=${pos#secrets versions add }
    need_secret "$id"
    n=1
    while [ -f "$sm/$id/$n.state" ]; do n=$((n + 1)); done
    cat >"$sm/$id/$n.data"
    cat "$sm/$id/$n.data" >>"$S/stdin.log"
    printf ENABLED >"$sm/$id/$n.state"
    date -u +%Y-%m-%dT%H:%M:%S.000000Z | tr -d '\n' >"$sm/$id/$n.time"
    echo "$n"
    ;;
  "secrets versions access "*)
    v=${pos#secrets versions access }
    need_secret "$secret"
    need_version "$secret" "$v"
    if [ -n "${STUB_DENY_ACCESS:-}" ]; then echo "ERROR: PERMISSION_DENIED: secretmanager.versions.access" >&2; exit 1; fi
    [ "$(cat "$sm/$secret/$v.state")" = ENABLED ] || { echo "ERROR: FAILED_PRECONDITION: version is not enabled" >&2; exit 1; }
    cat "$sm/$secret/$v.data"
    ;;
  "secrets versions disable "*)
    v=${pos#secrets versions disable }
    need_version "$secret" "$v"
    printf DISABLED >"$sm/$secret/$v.state"
    ;;
  "secrets versions destroy "*)
    v=${pos#secrets versions destroy }
    need_version "$secret" "$v"
    printf DESTROYED >"$sm/$secret/$v.state"
    rm -f "$sm/$secret/$v.data"
    ;;
  "secrets get-iam-policy "*)
    id=${pos#secrets get-iam-policy }
    need_secret "$id"
    cat "$S/iam/$project/$id.json" 2>/dev/null || echo '{}'
    ;;
  "run services list" | "run jobs list")
    kind='services'
    [ "$pos" = "run jobs list" ] && kind='jobs'
    f="$S/run/$project/$kind.json"
    [ -f "$f" ] || f=/dev/null
    if [ "$format" = json ]; then jq -s 'add // []' "$f"; else jq -r '.[].metadata.name' "$f"; fi
    ;;
  "iam service-accounts list")
    cat "$S/iam/$project/service-accounts.txt" 2>/dev/null || true
    ;;
  *)
    echo "stub gcloud: unsupported command: $pos" >&2
    exit 2
    ;;
esac
