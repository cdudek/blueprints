#!/usr/bin/env bash
# shellcheck disable=SC2016 # jq programs take their $variables in single quotes
# secrets: declare, set, rotate, rename and check an app's secrets.
# Output is names, version numbers, dates and states, never values. Needs bash 3.2+, jq 1.6+, gcloud.
set +x # a value must never reach a trace, even under `bash -x secrets ...`

SUPPORTED_SCHEMA=1
COMMON_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

# shellcheck source=backends/gcp.bash
. "$COMMON_DIR/secrets/backends/${SECRETS_BACKEND:-gcp}.bash"

die() { printf 'secrets: %s\n' "$*" >&2; exit 1; }
note() { printf 'secrets: %s\n' "$*" >&2; }

# --- naming (plan B) ---------------------------------------------------------------------------

RE_ENV='^(dev|staging|prod|pr-[0-9]{1,4})$'
RE_REPO='^[a-z][a-z0-9-]{1,9}[a-z0-9]$'
KINDS='(web|worker|migrate|ci|deploy|images|files|tfstate|sql|secrets-rotation|[a-z][a-z0-9-]{0,8}[a-z0-9])'
RE_KIND="^${KINDS}\$"
RE_PURPOSE='^[a-z][a-z0-9]*(-[a-z0-9]+)*$'
RE_ENVVAR='^[A-Z][A-Z0-9_]*$'
RE_PROJECT='^[a-z][a-z0-9-]{4,28}[a-z0-9]$'
RE_LABEL='^[a-z0-9_-]{1,63}$'

# has_line LIST ITEM: ITEM is one of LIST's lines (no grep, so no SIGPIPE under pipefail).
has_line() { case $'\n'$1$'\n' in *$'\n'"$2"$'\n'*) return 0 ;; esac; return 1; }

to_envvar() { printf '%s' "$1" | tr 'a-z-' 'A-Z_'; }

# name_ok TYPE VALUE [REPO ENV]: TYPE is env, repo, kind, purpose, resource, sa, secret, envvar or db.
name_ok() {
  local type=$1 value=$2 repo=${3:-} env=${4:-} re
  case $type in
    env) re=$RE_ENV ;;
    repo) re=$RE_REPO ;;
    kind) re=$RE_KIND ;;
    purpose) re=$RE_PURPOSE ;;
    envvar) re=$RE_ENVVAR ;;
    resource | sa)
      [ "$type" = sa ] && [ ${#value} -gt 30 ] && return 1
      re="^${repo}-${KINDS}-${env}\$" ;;
    secret)
      [ ${#value} -le 255 ] || return 1
      re="^${repo}-[a-z][a-z0-9]*(-[a-z0-9]+)*-${env}\$" ;;
    db)
      local r=${repo//-/_} e=${env//-/_}
      re="^${r}_${e}\$" ;;
    *) return 2 ;;
  esac
  case $type in resource | sa | secret | db)
    [[ $repo =~ $RE_REPO ]] && [[ $env =~ $RE_ENV ]] || return 1 ;;
  esac
  [[ $value =~ $re ]]
}

# --- manifest (plan C) -------------------------------------------------------------------------

MANIFEST=${SECRETS_MANIFEST:-secrets.manifest.json}

mjq() { jq -r "$@" "$MANIFEST"; }

# Structure and types; names are checked in bash so one regex set serves the CLI and its tests.
STRUCTURE_JQ='
def int: type == "number" and . == floor;
def str: type == "string" and length > 0;
if type != "object" then "manifest: must be a JSON object" else
  ((keys - ["$schema","schemaVersion","repo","envs","projects","rollbackWindowDays","secrets"])[] | "manifest: unknown key \(.)"),
  (if (.schemaVersion | int) and .schemaVersion >= 1 then empty else "schemaVersion: must be an integer >= 1" end),
  (if .repo | str then empty else "repo: required string" end),
  (if (.envs | type) == "array" and (.envs | length) > 0 and all(.envs[]; str)
   then (if (.envs | unique | length) == (.envs | length) then empty else "envs: duplicate entries" end)
   else "envs: must be a non-empty array of strings" end),
  (if (.rollbackWindowDays | int) and .rollbackWindowDays >= 1 then empty else "rollbackWindowDays: must be an integer >= 1" end),
  (if has("projects") then
     (if (.projects | type) == "object" then (.projects | to_entries[] | select(.value | str | not) | "projects.\(.key): must be a string")
      else "projects: must be an object" end)
   else empty end),
  (if (.secrets | type) != "object" then "secrets: must be an object" else
     .secrets | to_entries[] | .key as $k | .value as $v |
     if ($v | type) != "object" then "secrets.\($k): must be an object" else
       (($v | keys) - ["description","owner","readers","local","rotationDays","probe","generated","ci","ciReason"])[] as $x | "secrets.\($k): unknown key \($x)"
     end,
     if ($v | type) != "object" then empty else
       (if $v.description | str then empty else "secrets.\($k).description: required string" end),
       (if $v.owner | str then empty else "secrets.\($k).owner: required string" end),
       (if ($v.readers | type) == "array" and all($v.readers[]; str) then empty else "secrets.\($k).readers: must be an array of kinds" end),
       (if ($v | has("local")) and ($v.local | type) != "boolean" then "secrets.\($k).local: must be true or false" else empty end),
       (if ($v | has("rotationDays")) and (($v.rotationDays | int) and $v.rotationDays >= 1 | not) then "secrets.\($k).rotationDays: must be an integer >= 1" else empty end),
       (if ($v | has("probe")) and ($v.probe | str | not) then "secrets.\($k).probe: must be a path" else empty end),
       (if ($v | has("generated")) then
          (if ($v.generated | type) == "object" and ($v.generated | keys) == ["bytes"] and ($v.generated.bytes | int) and $v.generated.bytes >= 16 and $v.generated.bytes <= 512
           then empty else "secrets.\($k).generated: must be {\"bytes\": 16..512}" end),
          (if $v | has("probe") then "secrets.\($k): a generated secret has no probe" else empty end)
        else empty end),
       (if ($v | has("ci")) and ($v.ci | type) != "boolean" then "secrets.\($k).ci: must be true or false" else empty end),
       (if $v.ci == true and ($v.ciReason | str | not) then "secrets.\($k): ci needs a ciReason" else empty end),
       (if ($v | has("ciReason")) and $v.ci != true then "secrets.\($k): ciReason without ci: true" else empty end)
     end
   end)
end'

# validate_manifest: prints every problem, returns 1 if there is one. Sets REPO, ENVS, WINDOW.
validate_manifest() {
  [ -f "$MANIFEST" ] || { note "no manifest at $MANIFEST (set SECRETS_MANIFEST)"; return 1; }
  local errs
  errs=$(jq -r "$STRUCTURE_JQ" "$MANIFEST" 2>&1) || { note "manifest: not valid JSON: $errs"; return 1; }
  if [ -n "$errs" ]; then printf '%s\n' "$errs" | sed 's/^/secrets: /' >&2; return 1; fi

  local bad=0 e p k v env
  REPO=$(mjq .repo)
  ENVS=$(mjq '.envs[]')
  WINDOW=$(mjq .rollbackWindowDays)
  name_ok repo "$REPO" || { note "repo: '$REPO' must match $RE_REPO (3 to 11 characters)"; bad=1; }
  for env in $ENVS; do name_ok env "$env" || { note "envs: '$env' must match $RE_ENV"; bad=1; }; done
  while IFS=$'\t' read -r e p; do
    [ -n "$e" ] || continue
    has_line "$ENVS" "$e" || { note "projects.$e: not one of envs"; bad=1; }
    [[ $p =~ $RE_PROJECT ]] || { note "projects.$e: '$p' is not a GCP project id"; bad=1; }
  done < <(mjq '.projects // {} | to_entries[] | "\(.key)\t\(.value)"')
  [ "$bad" = 0 ] || return 1

  while IFS= read -r p; do
    [ -n "$p" ] || continue
    if ! name_ok purpose "$p"; then note "secrets.$p: purpose must be lowercase kebab-case ($RE_PURPOSE)"; bad=1; continue; fi
    case "-$p-" in *"-$REPO-"*) note "secrets.$p: purpose must not repeat the repo '$REPO'"; bad=1 ;; esac
    for env in dev staging prod $ENVS; do
      case "-$p-" in *"-$env-"*) note "secrets.$p: purpose must not repeat the environment '$env'"; bad=1; break ;; esac
    done
    name_ok envvar "$(to_envvar "$p")" || { note "secrets.$p: env var $(to_envvar "$p") is not UPPER_SNAKE"; bad=1; }
    v=$(mjq --arg k "$p" '.secrets[$k].owner')
    [[ $v =~ $RE_LABEL ]] || { note "secrets.$p.owner: '$v' is not a label value (lowercase, digits, _ and -, up to 63)"; bad=1; }
    for k in $(mjq --arg k "$p" '.secrets[$k].readers[]'); do
      if ! name_ok kind "$k"; then note "secrets.$p.readers: '$k' is not a kind"; bad=1; continue; fi
      for env in $ENVS; do
        name_ok sa "$REPO-$k-$env" "$REPO" "$env" || { note "secrets.$p.readers: service account $REPO-$k-$env breaks the naming rule or 30 characters"; bad=1; }
      done
    done
    for env in $ENVS; do
      name_ok secret "$REPO-$p-$env" "$REPO" "$env" || { note "secrets.$p: secret id $REPO-$p-$env breaks the naming rule"; bad=1; }
    done
  done < <(mjq '.secrets | keys[]')

  v=$(mjq .schemaVersion)
  if [ "$v" -gt "$SUPPORTED_SCHEMA" ]; then
    note "warning: manifest schemaVersion $v is newer than this common ($(cat "$COMMON_DIR/VERSION" 2>/dev/null || echo unknown)) supports ($SUPPORTED_SCHEMA); upgrade tools/common"
  fi
  return "$bad"
}

load_manifest() {
  validate_manifest || die "fix $MANIFEST first"
  ROOT=$(cd "$(dirname "$MANIFEST")" && pwd)
}

declared() { [ "$(mjq --arg k "$1" '.secrets | has($k)')" = true ]; }
is_generated() { [ "$(mjq --arg k "$1" '.secrets[$k] | has("generated")')" = true ]; }
purposes() { mjq '.secrets | keys[]'; }

require_declared() {
  declared "$1" || die "'$1' is not declared in $MANIFEST; declare it first, then apply Terraform"
}

require_env() {
  [ -n "$1" ] || die "--env is required"
  name_ok env "$1" || die "--env '$1' must match $RE_ENV"
  has_line "$ENVS" "$1" || die "--env '$1' is not in the manifest's envs"
}

# envs_to_walk ENV_OPT: the one environment asked for, or all of them.
envs_to_walk() { if [ -n "$1" ]; then require_env "$1"; echo "$1"; else echo "$ENVS"; fi; }

project_for() {
  local p
  p=$(mjq --arg e "$1" '.projects[$e] // empty')
  printf '%s' "${p:-$REPO-$1}"
}

secret_id() { printf '%s-%s-%s' "$REPO" "$1" "$2"; }

# --- pins: secret-versions/<env>.json, written only by this CLI, read by Terraform ----------------

pin_file() { printf '%s/secret-versions/%s.json' "$ROOT" "$1"; }

pin_get() {
  local f
  f=$(pin_file "$2")
  [ -f "$f" ] || return 0
  jq -r --arg k "$1" '.[$k] // empty' "$f"
}

pin_set() {
  local f
  f=$(pin_file "$2")
  mkdir -p "$(dirname "$f")"
  [ -f "$f" ] || echo '{}' >"$f"
  jq -S --arg k "$1" --arg v "$3" '.[$k] = $v' "$f" >"$f.tmp" && mv "$f.tmp" "$f"
}

# --- version helpers ---------------------------------------------------------------------------

# age_days CREATED: whole days since an RFC 3339 time (fractional seconds allowed).
age_days() {
  jq -rn --arg t "$1" '(now - ($t | sub("\\.[0-9]+"; "") | fromdateiso8601)) / 86400 | floor'
}

date_in_days() { jq -rn --argjson d "$1" 'now + $d * 86400 | strftime("%Y-%m-%d")'; }

# field VERSIONS N COLUMN: COLUMN 2 is the state, 3 the create time, of version N.
field() { printf '%s\n' "$1" | awk -F '\t' -v n="$2" -v c="$3" '$1 == n { print $c }'; }

# newest_enabled VERSIONS: the highest enabled version number.
newest_enabled() { printf '%s\n' "$1" | awk -F '\t' '$2 == "ENABLED" { print $1 }' | sort -n | tail -1; }

# refs_for LIVE_REFS SECRET_ID: "RESOURCE VERSION" for each live reference to SECRET_ID.
refs_for() { printf '%s\n' "$1" | awk -F '\t' -v s="$2" '$2 == s { print $1 " " $3 }'; }

# --- read-only commands ------------------------------------------------------------------------

cmd_env_names() {
  load_manifest
  local p
  for p in $(purposes); do to_envvar "$p"; echo; done
}

cmd_list() {
  load_manifest
  local envs env project ids p id versions enabled pin readers
  envs=$(envs_to_walk "$ENV_OPT")
  for env in $envs; do
    project=$(project_for "$env")
    ids=$(backend_secret_ids "$project")
    for p in $(purposes); do
      id=$(secret_id "$p" "$env")
      if ! has_line "$ids" "$id"; then
        printf '%s\t%s\tmissing\n' "$env" "$id"
        continue
      fi
      versions=$(backend_versions "$project" "$id")
      enabled=$(printf '%s\n' "$versions" | awk -F '\t' '$2 == "ENABLED" { sub(/T.*/, "", $3); print $1 "@" $3 }' | sort -n | paste -sd, -)
      pin=$(pin_get "$p" "$env")
      if is_generated "$p"; then pin="generated${pin:+ (generation $pin)}"; fi
      readers=$(backend_accessors "$project" "$id")
      printf '%s\t%s\tpinned=%s\tenabled=%s\treaders=%s\n' "$env" "$id" "${pin:-none}" "${enabled:-none}" "${readers:-none}"
    done
  done
}

DRIFT=0
WARNINGS=0
drift() { printf 'DRIFT %s\n' "$*"; DRIFT=$((DRIFT + 1)); }
warn() { printf 'WARN  %s\n' "$*"; WARNINGS=$((WARNINGS + 1)); }

cmd_check() {
  load_manifest
  local envs env project ids refs names declared_ids p id versions newest pin st v age days r rv older type name
  envs=$(envs_to_walk "$ENV_OPT")
  for p in $(purposes); do
    if [ "$(mjq --arg k "$p" '.secrets[$k].ci == true')" = true ]; then
      warn "$p: CI exception, the value also lives in a CI variable ($(mjq --arg k "$p" '.secrets[$k].ciReason'))"
    fi
  done
  for env in $envs; do
    project=$(project_for "$env")
    ids=$(backend_secret_ids "$project")
    refs=$(backend_live_refs "$project")
    names=$(backend_resource_names "$project")
    declared_ids=''
    for p in $(purposes); do
      id=$(secret_id "$p" "$env")
      declared_ids="$declared_ids$id"$'\n'
      if ! has_line "$ids" "$id"; then drift "$env $id: declared but missing in Secret Manager"; continue; fi
      versions=$(backend_versions "$project" "$id")
      newest=$(newest_enabled "$versions")
      if [ -z "$newest" ]; then drift "$env $id: no enabled version"; continue; fi

      if is_generated "$p"; then
        pin=$newest # Terraform writes generated values; the live one is the newest enabled version
      else
        pin=$(pin_get "$p" "$env")
        if [ -z "$pin" ]; then
          drift "$env $id: no pinned version in secret-versions/$env.json"
        else
          st=$(field "$versions" "$pin" 2)
          if [ -z "$st" ]; then drift "$env $id: pinned version $pin does not exist"
          elif [ "$st" != ENABLED ]; then drift "$env $id: pinned version $pin is $st"
          elif [ "$newest" -gt "$pin" ]; then warn "$env $id: version $newest is newer than the pin $pin and not rolled out"
          fi
        fi
      fi

      days=$(mjq --arg k "$p" '.secrets[$k].rotationDays // empty')
      if [ -n "$days" ]; then
        age=$(age_days "$(field "$versions" "$newest" 3)")
        [ "$age" -lt "$days" ] || warn "$env $id: rotation overdue, newest version is $age days old (rotationDays $days)"
      fi

      if [ -n "$pin" ] && [ -n "$(field "$versions" "$pin" 3)" ] && [ "$(age_days "$(field "$versions" "$pin" 3)")" -ge "$WINDOW" ]; then
        older=$(printf '%s\n' "$versions" | awk -F '\t' -v p="$pin" '$2 == "ENABLED" && $1 + 0 < p + 0 { print $1 }' | sort -n | paste -sd, -)
        [ -z "$older" ] || warn "$env $id: versions $older are older than the live version $pin and past the ${WINDOW}-day rollback window; run retire"
      fi

      while read -r r rv; do
        [ -n "$r" ] || continue
        if [ "$rv" = latest ]; then drift "$env $id: $r reads latest; pin a version"
        elif [ -n "$pin" ] && [ "$rv" != "$pin" ]; then drift "$env $id: $r reads version $rv, the pin is $pin (Terraform not applied?)"
        fi
      done < <(refs_for "$refs" "$id")
    done

    for id in $ids; do
      has_line "$declared_ids" "$id" || drift "$env $id: in Secret Manager but not declared in the manifest"
    done

    while IFS=$'\t' read -r type name; do
      [ -n "$name" ] || continue
      v=resource
      [ "$type" = sa ] && v=sa
      name_ok "$v" "$name" "$REPO" "$env" || drift "$env $type $name: breaks <repo>-<kind>-<env> ($REPO-<kind>-$env)"
    done < <(printf '%s\n' "$names")
  done
  printf 'check: %d drift, %d warnings\n' "$DRIFT" "$WARNINGS"
  [ "$DRIFT" -eq 0 ]
}

# --- main ----------------------------------------------------------------------------------------

usage() {
  cat <<'EOF'
usage: secrets <command> [args]

  list [--env E]                                  versions, pins and readers per secret
  check [--env E]                                 manifest, naming, pins and live references; non-zero on drift
  env-names                                       the env var names the manifest declares
  set NAME --env E [--stdin] [--disable-previous] add a version from a hidden prompt (human)
  rotate NAME --env E                             set; rerun after the rollout to disable old versions (human)
  retire NAME --env E [--destroy] [--all]         disable, then destroy, versions past the rollback window (human)
  rename OLD NEW --env E [--apply]                copy OLD's newest version to NEW; dry run without --apply
  rename-repo OLD_REPO NEW_REPO --env E [--apply] copy every secret to the new repo name; dry run without --apply
  dev-env -- CMD...                               run CMD with the local dev secrets in its environment (human)

The manifest is ./secrets.manifest.json, or SECRETS_MANIFEST.
EOF
}

ENV_OPT='' STDIN=0 DISABLE_PREVIOUS=0 APPLY=0 DESTROY=0 ALL=0 ARG1='' ARG2=''

parse_args() {
  while [ $# -gt 0 ]; do
    case $1 in
      --env) [ $# -ge 2 ] || die "--env needs a value"; ENV_OPT=$2; shift 2 ;;
      --env=*) ENV_OPT=${1#*=}; shift ;;
      --stdin) STDIN=1; shift ;;
      --disable-previous) DISABLE_PREVIOUS=1; shift ;;
      --apply) APPLY=1; shift ;;
      --destroy) DESTROY=1; shift ;;
      --all) ALL=1; shift ;;
      -*) die "unknown option '$1'" ;;
      *)
        if [ -z "$ARG1" ]; then ARG1=$1; elif [ -z "$ARG2" ]; then ARG2=$1; else die "too many arguments"; fi
        shift ;;
    esac
  done
}

main() {
  local cmd=${1:-}
  [ $# -gt 0 ] && shift
  case $cmd in
    -h | --help | help | "") usage; return ;;
  esac
  parse_args "$@"
  case $cmd in
    list) cmd_list ;;
    check) cmd_check ;;
    env-names) cmd_env_names ;;
    *) usage >&2; die "unknown command '$cmd'" ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  set -euo pipefail
  main "$@"
fi
