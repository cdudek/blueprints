{
  "$schema": "./architecture.schema.json",
  "version": 1,
  "srcRoot": "src",
  "doors": ["public.ts", "server.ts"],
  "modules": {
    "orders": { "description": "Placing, listing and cancelling orders" },
    "billing": { "description": "Prices and payment attempts for orders" }
  },
  "edges": [
    {
      "from": "orders",
      "to": "billing",
      "reason": "orders asks billing for prices and starts and cancels payments"
    }
  ],
  "tables": {
    "orders": "orders",
    "prices": "billing",
    "payments": "billing"
  },
  "readExceptions": [],
  "exemptions": [],
  "clients": ["payments"]
}
