{
  "$schema": "./architecture.schema.json",
  "$schemaVersion": "1.0.0",
  "version": 1,
  "srcRoot": "src",
  "doors": {
    "public.ts": "browser",
    "server.ts": "server"
  },
  "roots": ["proxy.ts", "instrumentation.ts"],
  "modules": {
    "accounts": {
      "description": "The signed-in session: reads it for pages and actions"
    },
    "orders": {
      "description": "Placing, listing and cancelling orders"
    },
    "billing": {
      "description": "Prices and payment attempts for orders"
    }
  },
  "sessionModule": "accounts",
  "edges": [
    {
      "from": "orders",
      "to": "billing",
      "reason": "orders asks billing for prices and starts and cancels payments"
    }
  ],
  "tables": {
    "orders": "orders",
    "prices": "billing",
    "payments": "billing",
    "payment_inbox": "billing"
  },
  "readExceptions": [],
  "exemptions": [],
  "clients": ["payments"],
  "serverOnlyPackages": [
    "server-only",
    "next/headers",
    "postgres",
    "drizzle-orm/postgres-js",
    "drizzle-orm/pglite"
  ],
  "rulesMayImport": ["zod"]
}
