{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "architecture.schema.json",
  "title": "Architecture policy",
  "description": "The single source of truth for module boundaries. Both lint and the architecture tests are built from it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schemaVersion",
    "version",
    "srcRoot",
    "doors",
    "roots",
    "modules",
    "edges",
    "tables",
    "readExceptions",
    "exemptions",
    "clients",
    "serverOnlyPackages",
    "rulesMayImport"
  ],
  "definitions": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "reason": {
      "type": "string",
      "minLength": 10
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "srcRoot": {
      "type": "string",
      "minLength": 1
    },
    "doors": {
      "description": "Door file name -> role. A browser door exports only browser-safe types, schemas and components. A server door exports only service operations and server components. Both are listed by name, never `export *`.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9.-]+\\.tsx?$"
      },
      "additionalProperties": {
        "enum": ["browser", "server"]
      }
    },
    "modules": {
      "description": "One folder src/modules/<name> each.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/name"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description"],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "edges": {
      "description": "Declared module dependencies. Anything not listed is refused; a cycle is refused.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "reason"],
        "properties": {
          "from": {
            "$ref": "#/definitions/name"
          },
          "to": {
            "$ref": "#/definitions/name"
          },
          "reason": {
            "$ref": "#/definitions/reason"
          }
        }
      }
    },
    "tables": {
      "description": "Every table and the one module that owns it. Only the owner writes it.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/name"
      }
    },
    "readExceptions": {
      "description": "One reader FILE may import one owner table directly, for reads only. Prefer an owner query function; an import check cannot tell a read from a raw-SQL write.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "table", "reason"],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^src/modules/[a-z0-9-]+/.+\\.tsx?$"
          },
          "table": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "$ref": "#/definitions/reason"
          }
        }
      }
    },
    "exemptions": {
      "description": "Files a rule does not apply to, for example seed scripts. Never for a non-negotiable rule.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "rules", "reason"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "reason": {
            "$ref": "#/definitions/reason"
          }
        }
      }
    },
    "clients": {
      "description": "Third-party ports under src/clients/<name>, each with providers/.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/name"
      },
      "uniqueItems": true
    },
    "$schemaVersion": {
      "description": "The blueprint release this file was written for. Scripts refuse a different major version.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "roots": {
      "description": "Files allowed directly under srcRoot. Every other file must live in app, modules/<declared>, shared, ui, db or clients/<declared>.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "serverOnlyPackages": {
      "description": "Packages (and subpaths) a browser bundle must never reach, besides Node builtins.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rulesMayImport": {
      "description": "External packages a *.rules.ts file may use. Rules otherwise reach only other rules, types, schemas and shared/result.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "x-schemaVersion": "1.0.0"
}
