{
  "path": ["src", "scripts", "tests/e2e"],
  "format": ["typescript", "tsx", "javascript"],
  "minTokens": 50,
  "minLines": 5,
  "reporters": ["json", "html"],
  "output": "./reports/jscpd",
  "gitignore": true,
  "ignore": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/fixtures/**",
    "**/drizzle/**",
    "**/messages/**",
    "**/locales/**",
    "**/*.json",
    "**/*.css",
    "**/*.generated.*"
  ]
}
