{
  "$schemaVersion": "1.0.0",
  "version": 1,
  "srcRoot": "src",
  "doors": {
    "public.ts": "browser",
    "server.ts": "server"
  },
  "roots": [
    "proxy.ts"
  ],
  "modules": {
    "orders": {
      "description": "orders"
    },
    "billing": {
      "description": "billing"
    },
    "ledger": {
      "description": "ledger"
    },
    "half": {
      "description": "has only one door"
    },
    "phantom": {
      "description": "declared, no files"
    }
  },
  "edges": [
    {
      "from": "orders",
      "to": "billing",
      "reason": "orders asks billing for prices"
    },
    {
      "from": "ledger",
      "to": "billing",
      "reason": "ledger settles through billing"
    }
  ],
  "tables": {
    "orders": "orders",
    "payments": "billing",
    "invoices": "orders",
    "ghosts": "billing",
    "prices": "billing"
  },
  "readExceptions": [],
  "exemptions": [],
  "clients": [
    "payments"
  ],
  "serverOnlyPackages": [
    "server-only",
    "next/headers",
    "postgres"
  ],
  "rulesMayImport": [
    "zod"
  ]
}