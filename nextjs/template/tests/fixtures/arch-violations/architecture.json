{
  "$schemaVersion": "1.0.0",
  "version": 1,
  "srcRoot": "src",
  "doors": {
    "public.ts": "browser",
    "server.ts": "server"
  },
  "roots": [
    "proxy.ts",
    "instrumentation.ts",
    "worker.ts"
  ],
  "modules": {
    "orders": {
      "description": "orders"
    },
    "billing": {
      "description": "billing"
    },
    "ledger": {
      "description": "ledger"
    },
    "half": {
      "description": "has only one door"
    },
    "phantom": {
      "description": "declared, no files"
    },
    "catalog": {
      "description": "a door with a client directive"
    }
  },
  "sessionModule": "ledger",
  "edges": [
    {
      "from": "orders",
      "to": "billing",
      "reason": "orders asks billing for prices"
    },
    {
      "from": "ledger",
      "to": "billing",
      "reason": "ledger settles through billing"
    },
    {
      "from": "billing",
      "to": "ledger",
      "reason": "closes a cycle with ledger -> billing"
    }
  ],
  "tables": {
    "orders": "orders",
    "payments": "billing",
    "invoices": "orders",
    "ghosts": "billing",
    "prices": "billing"
  },
  "readExceptions": [],
  "exemptions": [],
  "clients": [
    "payments"
  ],
  "serverOnlyPackages": [
    "server-only",
    "next/headers",
    "postgres"
  ],
  "rulesMayImport": [
    "zod"
  ],
  "uiMayImport": [
    "react",
    "lucide-react"
  ],
  "iconPackages": [
    "lucide-react"
  ],
  "bannedPackages": {
    "axios": "external HTTP goes through a port in clients/ with an injected fetch"
  }
}