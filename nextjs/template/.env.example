# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/app

# Tests use PGlite unless this is set (CI points it at the Postgres service).
# TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/app_test

# fixture (default outside production) | noop | real (production only, needs the key)
# PAYMENTS_PROVIDER=fixture
# PAYMENTS_API_KEY=replace-me
# PAYMENTS_WEBHOOK_SECRET=replace-me
